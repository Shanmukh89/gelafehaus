# Supabase Connection for Gelafehaus
# NEVER use or reference a service role key here.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare Turnstile Public Site Key (Frontend)
# Dummy always-pass test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# NOTE: The Turnstile Secret Key (TURNSTILE_SECRET_KEY) and Supabase Service Role Key
# are configured exclusively in Supabase Edge Function Secrets and NEVER in .env or the repo.
